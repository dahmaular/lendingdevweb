# Default for `npm run build`. These are the production values devpay.ng ships
# with.
#
# A real environment variable always wins over this file (dotenv does not
# overwrite process.env), so setting these in the Vercel dashboard overrides
# them per environment — that is how the develop branch is pointed at staging
# without touching this file.
#
# IMPORTANT: `react-scripts build` forces NODE_ENV=production for every build,
# including Vercel Preview builds. A Preview deployment with no dashboard
# overrides therefore falls through to THESE production values.
REACT_APP_API_BASE_URL=https://devpayprod-cvd7axbkemare5dn.southafricanorth-01.azurewebsites.net/api/v1
REACT_APP_PRODUCT_ID=00487268-6698-4fe4-bda2-39fc32c60a1d
