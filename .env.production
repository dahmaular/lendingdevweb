# Default for `npm run build`. This is the value devpay.ng ships with.
#
# A real environment variable always wins over this file (dotenv does not
# overwrite process.env), so setting REACT_APP_API_BASE_URL in the Vercel
# dashboard overrides it per environment — that is how the staging domain is
# pointed at the staging backend without touching this file.
REACT_APP_API_BASE_URL=https://devpayprod-cvd7axbkemare5dn.southafricanorth-01.azurewebsites.net/api/v1
