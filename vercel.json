{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "github": {
    "silent": true
  },
  "rewrites": [
    {
      "source": "/((?!static/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!static/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
